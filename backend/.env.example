# Application
PROJECT_NAME="STAP Backend"
ENV="development"
FRONTEND_URL="http://localhost:3000"
PORT=8000

# Authentication & Security
SECRET_KEY="replace-with-a-random-secret-before-deploying"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Vector DB
DATABASE_URL="sqlite:///./stap.db"
CHROMA_PERSIST_DIRECTORY="./chroma_data"

# AI / LLM Configuration
LLM_PROVIDER="mock" # options: "mock", "openai", "anthropic", "gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_DEMO="5/minute"
